# Public origin used for the Paystack payment callback and fulfillment message.
APP_URL=https://elcartelyong.com
PORT=8787
DATA_DIR=./data
MAX_DIGITAL_FILE_MB=250

# Bootstrap the first administrator on the first database start only.
# Use a unique password of at least 12 characters; never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack test key for development; store production keys in the host's secret manager.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# SMTP for verified-payment fulfillment emails; account downloads work without email settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
